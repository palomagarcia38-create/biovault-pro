    "test:training": "node tests/training.test.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.4.7",
    "firebase": "10.14.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "esbuild": "0.25.12",
    "firebase-tools": "14.27.0",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.19"
  }
