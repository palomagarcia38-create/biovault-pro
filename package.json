    "test:accounts": "node tests/accounts.test.cjs",
    "test:rules": "node tests/rules.test.cjs",
    "test:mobile": "node tests/mobile.test.cjs",
    "test:goals": "node tests/goals.test.cjs",
    "test:multibrand": "node tests/multibrand.test.cjs",
